<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ChaoticWind</AssemblyName>
    <RootNamespace>ChaoticWind</RootNamespace>
    <Version>1.2.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <ChaoticWindInstallDir>..\Sailwind\BepInEx\plugins\ChaoticWind</ChaoticWindInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>..\Sailwind\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\Sailwind\Sailwind_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>..\Sailwind\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\Sailwind\Sailwind_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\Sailwind\Sailwind_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="InstallToWorkspaceSailwind" AfterTargets="Build">
    <MakeDir Directories="$(ChaoticWindInstallDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ChaoticWindInstallDir)" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb"
          DestinationFolder="$(ChaoticWindInstallDir)"
          Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
  </Target>
</Project>
